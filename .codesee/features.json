      "from": "f-manage-process",
      "to": "f-register-s6-service",
      "kind": "depends_on",
      "note": "启停依赖已注册的 s6 服务"
    },
    {
      "from": "f-cron-schedule",
      "to": "f-manage-process",
      "kind": "triggers",
      "note": "定时任务触发重启流程"
    },
    {
      "from": "f-cron-schedule",
      "to": "f-redeploy-process",
      "kind": "triggers",
      "note": "redeploy 规则触发重部署"
    },
    {
      "from": "f-cron-idle-start",
      "to": "f-manage-process",
      "kind": "triggers",
      "note": "空闲达标后自动 start"
    },
    {
      "from": "f-ping-keepalive",
      "to": "f-worker-lifecycle",
      "kind": "depends_on",
      "note": "等待 worker 写入就绪标记"
    },
    {
      "from": "f-load-project-config",
      "to": "f-dashboard-auth",
      "kind": "depends_on",
      "note": "仪表盘凭据来自 defaults"
    }
  ],
  "epic_flow": [
    {
      "from": "bootstrap",
      "to": "config",
      "kind": "next",
      "note": "容器启动后加载 project.toml"
    },
    {
      "from": "config",
      "to": "worker",
      "kind": "next",
      "note": "配置驱动各 worker 克隆与监督"
    },
    {
      "from": "worker",
      "to": "dashboard",
      "kind": "next",
      "note": "进程就绪后可在仪表盘观测与控制"
    },
    {
      "from": "dashboard",
      "to": "scheduler",
      "kind": "depends_on",
      "note": "Web 应用启动后注册 cron 后台任务"
    },
    {
      "from": "worker",
      "to": "keepalive",
      "kind": "depends_on",
      "note": "worker 就绪后保活才开始 ping"
    }
  ]
}
