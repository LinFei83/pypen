# =============================================================================
# project.toml — 本地模式示例 / 带注释的配置文件
# =============================================================================
# 将本文件复制为 `project.toml`，再按实际部署环境修改。
#
# 本地工作流：
#   1. 在仓库一级目录手动放置项目：projects/<id>/
#      （git clone、创建 venv、配置 .env 等均在宿主机完成）
#   2. 可用两种方式登记（二选一即可，无需重启 Docker）：
#        a) 网页仪表盘「项目管理」：自动扫描目录 → 填写 run_command → 保存并启用
#        b) 手改下方 [[project]]（id 必须与文件夹名一致）后，仍建议用网页「启用」或重启 worker
#   3. 网页保存会改写本文件中的 [[project]] 条目，并立刻注册 s6 服务
#
# 文件结构：
#   [defaults]   — 全局默认值
#   [upstream]   — 可选：启动时从远程 git 仓库自动更新 Pypen 自身
#   [[project]]  — 每个 worker 一条（数量不限）
#     [project.env]   — 由 Pypen/s6 注入进程环境的变量
#     [project.cron]  — 该 worker 的重启 / 空闲 / git-pull 调度
# =============================================================================


# -----------------------------------------------------------------------------
# [defaults]
# -----------------------------------------------------------------------------
[defaults]
# 在 worker 启动时安装一次的系统包（通过主机包管理器，如 dnf/apt）。
dnf_packages = ["ffmpeg", "aria2"]

# 是否启用保活 ping 服务。
ping = true
ping_url = ""


# -----------------------------------------------------------------------------
# [upstream] — 可选的自更新机制（针对 Pypen 自身代码，与 projects/ 无关）。
# -----------------------------------------------------------------------------
[upstream]
repo   = ""           # 例如 "https://github.com/youruser/yourfork"
branch = "main"


# =============================================================================
# [[project]] — 必填：id、run_command
# id 必须等于 projects/<id>/ 的文件夹名，并作为 s6 服务名。
# =============================================================================

# ── 最小示例 ─────────────────────────────────────────────────────────────────
[[project]]
# 对应目录：projects/mybot/
id          = "mybot"

# 在 projects/mybot/ 下执行的命令（原样写入 s6；勿写宿主机绝对路径）。
# 推荐：.venv/bin/python bot.py（宿主机 uv sync 后，compose 已挂载 uv 解释器/缓存，容器可直接复用）
# 若用 uv run，务必加 --no-sync，例如：uv run --no-sync python bot.py
# 不要单独写 uv run ...（默认会 sync，可能再次装依赖）
#
# 注意：容器会为仪表盘设置 PORT=5000。s6 启动项目前会 unset PORT，
# 以便应用读取自己的 .env；也可在 [project.env] 里显式写 PORT。
# 若要从宿主机访问项目服务，请在 docker-compose.yml 的 ports 中映射对应端口。
run_command = ".venv/bin/python bot.py"

# 按项目的日志轮转阈值。默认："10M"。
logs_size   = "10M"

# ---------------------------------------------------------------------------
# 环境变量分工（两者都可用，互不替代）：
#
#   [project.env]（下方）
#     由 Pypen 写入 s6 run 脚本的 export，进程启动即带上。
#     适合平台侧注入密钥、不想改仓库内文件的场景。
#
#   projects/<id>/.env
#     由应用自己加载（如 python-dotenv）。Pypen 不会自动 source。
#     适合仓库/应用本来就读 .env 的惯例；宿主机手动配环境时最自然。
#
# 可同时存在；同名键谁覆盖取决于应用 dotenv 的实现。
# ---------------------------------------------------------------------------
[project.env]
LOG_LEVEL = "info"
# BOT_TOKEN = "123456:ABC-DEF"

[project.cron]
# 每隔 N 小时重启。0 或 "" 表示禁用。
restart_on   = "0"
# 定时触发时是否「同步代码 + 重启」（git pull --ff-only）。
# 旧语义「重建 venv」已废弃；网页「重新同步代码」按钮始终可主动 pull，不依赖本项。
redeploy     = "false"
# 空闲达到该分钟数后自动启动。0 或 "" 表示禁用。
idle         = ""
# 每次（重新）启动前是否自动 git pull。默认 false。
# 与网页按钮无关：按钮始终允许主动同步。
pull_commits = "false"


# ── 第二个项目示例 ───────────────────────────────────────────────────────────
[[project]]
id          = "worker02"
run_command = "venv/bin/python -m mybot"
logs_size   = "50M"

[project.env]
DB_URL = "postgres://user:pass@host/db"

[project.cron]
restart_on   = "6"
redeploy     = "true"    # 每 6 小时：git pull + 重启
idle         = "10"
pull_commits = "false"
